{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bookmarks-colenso-org",
	"compatibility_date": "2026-08-16",
	// Static-only Worker: `npm run build` emits the whole site into ./build via
	// @sveltejs/adapter-static, and Wrangler uploads it as static assets. There is no
	// `main` entry point, so no `assets.binding` either — assets are served directly.
	"assets": {
		"directory": "./build"
	},
	// No `routes` here on purpose. The bookmarks.colenso.org custom domain is attached to
	// this Worker in the Cloudflare dashboard, which keeps the deploy token account-scoped:
	// declaring the route would make `wrangler deploy` call /zones/<id>/workers/routes, which
	// needs Zone-level Workers Routes and DNS permissions the CI token does not carry.
	// To move domain management back into this file, grant those zone permissions first.
	"observability": {
		"enabled": true
	}
}
